; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="아포칼립스 무신 : 멸망 이후의 제국"
run/main_scene="res://scenes/Main3D.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

RarityEnums="*res://scripts/autoload/RarityEnums.gd"
TraitManager="*res://scripts/autoload/TraitManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
PlayerStats="*res://scripts/autoload/PlayerStats.gd"
LootManager="*res://scripts/autoload/LootManager.gd"
CraftManager="*res://scripts/autoload/CraftManager.gd"
PetManager="*res://scripts/autoload/PetManager.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"
SharedMaterials="*res://scripts/autoload/SharedMaterials.gd"
Battlefield="*res://scripts/autoload/Battlefield.gd"
CombatFeel="*res://scripts/autoload/CombatFeel.gd"
VfxPool="*res://scripts/autoload/VfxPool.gd"
LandmarkRegistry="*res://scripts/autoload/LandmarkRegistry.gd"
SaveGame="*res://scripts/autoload/SaveGame.gd"
UpgradeManager="*res://scripts/autoload/UpgradeManager.gd"
AchievementManager="*res://scripts/autoload/AchievementManager.gd"
EventManager="*res://scripts/autoload/EventManager.gd"
NPCManager="*res://scripts/autoload/NPCManager.gd"
DemoDirector="*res://scripts/autoload/DemoDirector.gd"
ShotChapters="*res://tools/shoot_chapters.gd"
VerifySave="*res://tools/verify_save.gd"
VerifyPuzzles="*res://tools/verify_puzzles.gd"
VerifyAch="*res://tools/verify_achievements.gd"
VerifyUpg="*res://tools/verify_upgrades.gd"
VerifyEv="*res://tools/verify_events.gd"
VerifyNpc="*res://tools/verify_npc.gd"
VerifyQA="*res://tools/verify_qa.gd"
VerifyContent="*res://tools/verify_content.gd"
VerifyMaps="*res://tools/verify_maps.gd"
PlaytestBot="*res://tools/playtest_bot.gd"
DebugConsole="*res://tools/debug_console.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
