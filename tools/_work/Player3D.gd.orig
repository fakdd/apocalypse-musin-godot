extends CharacterBody3D

const DASH_SPEED := 26.0
const DASH_DURATION := 0.16
const DASH_COOLDOWN := 0.9
const ATTACK_COOLDOWN := 0.34
const ATTACK_RANGE := 4.2
const ATTACK_HALF_ANGLE := 1.0
const RANGED_COOLDOWN := 2.6
const RANGED_RANGE := 16.0
const PARRY_COOLDOWN := 4.0
const PARRY_WINDOW := 0.25
const ULT_RADIUS := 10.0
const GRAVITY := 24.0
const JUMP_SPEED := 9.0

signal died
signal hp_changed
signal ult_changed

var max_hp := 100.0
var hp := 100.0
var ult_gauge := 0.0
var ult_max := 100.0

var facing_angle := 0.0
var dash_dir := Vector3.ZERO
var dash_timer := 0.0
var dash_cd := 0.0
var atk_cd := 0.0
var ranged_cd := 0.0
var parry_cd := 0.0
var parry_timer := 0.0
var invuln_timer := 0.0
var attack_anim_timer := 0.0

var step_timer := 0.0
const STEP_INTERVAL := 0.34
const TURN_SPEED := 12.0      ## 모델 회전 보간 속도 (자연스러운 몸 돌리기)
const ACCEL := 22.0           ## 가감속 (즉시 정지/출발 방지)

## PlayerStats 연동 (특성/아이템이 실시간 반영됨)
var move_speed := 7.0
var slash_damage := 1.0

var model_yaw := 0.0
var model: Node3D
var skel: Skeleton3D
var spine_bones: Array[int] = []
var lean_pitch := 0.0        ## 가감속에 따른 앞뒤 기울기
var lean_roll := 0.0         ## 방향 전환에 따른 좌우 기울기
var prev_velocity := Vector3.ZERO
var land_squash := 0.0
var was_on_floor := true
var hit_anim_timer := 0.0
var jump_buffer := 0.0
var combo_step := 0
var combo_timer := 0.0
const COMBO_WINDOW := 0.85
var base_scale := Vector3.ONE
var weapon_attach: BoneAttachment3D = null
var weapon_mesh: MeshInstance3D = null   ## hero.tscn 에 구워진 원본 스케일 (덮어쓰면 캐릭터가 사라진다)
var anim: AnimationPlayer
var cam_rig: Node3D
var camera: Camera3D
var mesh_instances: Array = []

var shake_time := 0.0
var shake_mag := 0.0

func _ready() -> void:
	add_to_group("player")
	collision_layer = 2
	collision_mask = 1
	# 낮은 잔해에 걸리지 않게 계단 오르기를 허용한다
	floor_max_angle = deg_to_rad(60.0)
	floor_snap_length = 0.5
	safe_margin = 0.02

	max_hp = PlayerStats.get_final_max_hp()
	hp = max_hp
	PlayerStats.stats_changed.connect(_refresh_stats)
	_refresh_stats()

	var shape := CollisionShape3D.new()
	var caps := CapsuleShape3D.new()
	caps.radius = 0.45
	caps.height = 1.6
	shape.shape = caps
	shape.position.y = 0.8
	add_child(shape)

	var packed: PackedScene = load("res://assets3d/chars/hero.tscn")
	model = packed.instantiate()
	add_child(model)
	anim = _find_anim_player(model)
	_collect_meshes(model)
	base_scale = model.scale
	skel = model.find_child("Skeleton3D", true, false)
	if skel:
		for bone_name in ["mixamorig_Spine", "mixamorig_Spine1", "mixamorig_Spine2"]:
			var bi := skel.find_bone(bone_name)
			if bi >= 0:
				spine_bones.append(bi)
	_play_anim("idle")
	_setup_weapon_attach()
	PlayerStats.item_equipped.connect(func(_i, _s): _refresh_weapon_visual())
	_refresh_weapon_visual()

	cam_rig = Node3D.new()
	add_child(cam_rig)
	camera = Camera3D.new()
	camera.position = Vector3(0, 8.5, 7.0)
	camera.rotation_degrees = Vector3(-50, 0, 0)
	camera.fov = 62
	cam_rig.add_child(camera)
	camera.make_current()

## 특성이 뽑히거나 아이템을 장착할 때 호출되어 실시간 반영된다.
func _refresh_stats() -> void:
	move_speed = PlayerStats.get_final_speed()
	slash_damage = PlayerStats.get_slash_damage()
	var new_max := PlayerStats.get_final_max_hp()
	if new_max != max_hp:
		var ratio: float = (hp / max_hp) if max_hp > 0.0 else 1.0
		max_hp = new_max
		hp = clampf(max_hp * ratio, 1.0, max_hp)
		hp_changed.emit()

## 오른손 본에 무기를 부착한다 (장착 무기 스킨이 실제로 손에 들린다)
func _setup_weapon_attach() -> void:
	if skel == null:
		return
	var hand := skel.find_bone("mixamorig_RightHand")
	if hand < 0:
		hand = skel.find_bone("mixamorig_RightHandIndex1")
	if hand < 0:
		return
	weapon_attach = BoneAttachment3D.new()
	weapon_attach.bone_idx = hand
	skel.add_child(weapon_attach)

	weapon_mesh = MeshInstance3D.new()
	# 손 기준 위치/방향 보정
	weapon_mesh.position = Vector3(0.0, 0.06, 0.02)
	weapon_mesh.rotation_degrees = Vector3(-78, 0, 0)
	weapon_attach.add_child(weapon_mesh)

## 장착한 무기의 스킨을 손에 반영
func _refresh_weapon_visual() -> void:
	if weapon_mesh == null:
		return
	var w: ItemData = PlayerStats.equipped.get("weapon", null)
	if w == null:
		weapon_mesh.visible = false
		return
	weapon_mesh.visible = true
	weapon_mesh.mesh = ItemSkins.build_mesh(w.skin)
	weapon_mesh.material_override = ItemSkins.build_material(w.rarity)
	# 본 어태치먼트는 모델 스케일(92.5배)을 상속하므로 역수로 되돌린다.
	# 이 보정을 빼면 거대한 발광 검이 화면 전체를 하얗게 태운다.
	var inv: float = 1.0 / maxf(base_scale.x, 0.0001)
	var s: float = (0.9 + w.rarity * 0.06) * inv
	weapon_mesh.scale = Vector3(s, s, s)
	weapon_mesh.position = Vector3(0.0, 0.06, 0.02) * inv

func _find_anim_player(node: Node) -> AnimationPlayer:
	if node is AnimationPlayer:
		return node
	for c in node.get_children():
		var found := _find_anim_player(c)
		if found:
			return found
	return null

func _collect_meshes(node: Node) -> void:
	if node is MeshInstance3D:
		mesh_instances.append(node)
	for c in node.get_children():
		_collect_meshes(c)

func _play_anim(name: String) -> void:
	if anim == null:
		return
	if not anim.has_animation(name):
		return
	if anim.current_animation == name:
		return
	anim.play(name)

func _physics_process(delta: float) -> void:
	if hp <= 0:
		return

	if atk_cd > 0: atk_cd -= delta
	if dash_cd > 0: dash_cd -= delta
	if ranged_cd > 0: ranged_cd -= delta
	if parry_cd > 0: parry_cd -= delta
	if invuln_timer > 0: invuln_timer -= delta
	if parry_timer > 0: parry_timer -= delta
	if attack_anim_timer > 0: attack_anim_timer -= delta
	if combo_timer > 0:
		combo_timer -= delta
		if combo_timer <= 0:
			combo_step = 0

	_aim_at_mouse()

	if Input.is_key_pressed(KEY_SHIFT) and dash_cd <= 0 and dash_timer <= 0:
		_start_dash()

	var target_h := Vector3.ZERO
	var input_dir := Vector3.ZERO
	if dash_timer > 0:
		dash_timer -= delta
		target_h = dash_dir * DASH_SPEED
	else:
		if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP): input_dir.z -= 1
		if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN): input_dir.z += 1
		if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT): input_dir.x -= 1
		if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT): input_dir.x += 1
		if input_dir.length() > 0:
			input_dir = input_dir.normalized()
			target_h = input_dir * move_speed

	# 가감속 보간 — 즉시 정지/출발하지 않아 움직임이 자연스러워진다
	var accel := ACCEL if dash_timer <= 0 else ACCEL * 4.0
	velocity.x = move_toward(velocity.x, target_h.x, accel * delta)
	velocity.z = move_toward(velocity.z, target_h.z, accel * delta)
	if jump_buffer > 0.0:
		jump_buffer -= delta

	if not is_on_floor():
		velocity.y -= GRAVITY * delta
	else:
		if jump_buffer > 0.0:
			velocity.y = JUMP_SPEED
			jump_buffer = 0.0
			SoundManager.play("dash", -14.0)
		else:
			velocity.y = 0.0

	move_and_slide()

	var planar := Vector2(velocity.x, velocity.z).length()
	var moving := planar > 0.4

	# 이동 중에는 진행 방향을 바라보고, 공격/정지 시에는 마우스를 바라본다
	var desired_yaw := facing_angle
	if moving and dash_timer <= 0 and attack_anim_timer <= 0:
		desired_yaw = atan2(velocity.x, velocity.z)
	elif dash_timer > 0:
		desired_yaw = atan2(dash_dir.x, dash_dir.z)
	model_yaw = lerp_angle(model_yaw, desired_yaw, clampf(TURN_SPEED * delta, 0.0, 1.0))
	if model:
		model.rotation.y = model_yaw

	if hit_anim_timer > 0:
		hit_anim_timer -= delta
	elif attack_anim_timer <= 0:
		if dash_timer > 0:
			_play_anim("sprint")
		elif moving:
			# 조준 방향과 이동 방향이 반대면 뒷걸음 클립을 쓴다
			var move_dir := Vector3(velocity.x, 0, velocity.z).normalized()
			var aim := facing_dir()
			if anim and anim.has_animation("walk_back") and move_dir.dot(aim) < -0.35:
				_play_anim("walk_back")
			else:
				_play_anim("walk")
		elif GameManager.phase == GameManager.Phase.NIGHT and anim and anim.has_animation("idle_combat"):
			_play_anim("idle_combat")
		else:
			_play_anim("idle")
		# 실제 속도에 맞춰 애니메이션 재생 속도를 맞춰 미끄러짐을 줄인다
		if anim and moving and dash_timer <= 0:
			anim.speed_scale = clampf(planar / 7.0, 0.6, 2.2)
		elif anim:
			anim.speed_scale = 1.0

	if moving:
		step_timer -= delta * clampf(planar / 7.0, 0.5, 2.5)
		if step_timer <= 0:
			step_timer = STEP_INTERVAL
			SoundManager.play("footstep", -10.0)

	if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT) and atk_cd <= 0:
		_slash()
	if Input.is_key_pressed(KEY_Q) and ult_gauge >= ult_max:
		_ultimate()
	if Input.is_key_pressed(KEY_E) and ranged_cd <= 0 and GameManager.phase == GameManager.Phase.NIGHT:
		_ranged_wave()
	if Input.is_key_pressed(KEY_F) and parry_cd <= 0:
		_start_parry()

	_update_procedural_motion(delta, planar)

	cam_rig.global_position = global_position
	if shake_time > 0:
		shake_time -= delta
		camera.h_offset = randf_range(-shake_mag, shake_mag)
		camera.v_offset = randf_range(-shake_mag, shake_mag)
	else:
		camera.h_offset = 0.0
		camera.v_offset = 0.0

## 절차적 2차 모션 — 애니메이션 클립을 늘리지 않고도 "살아있는" 느낌을 만든다.
##  1) 가속/감속에 따라 몸이 앞뒤로 기운다
##  2) 방향을 틀 때 몸이 안쪽으로 기운다 (뱅킹)
##  3) 착지 시 스쿼시
##  4) 걸을 때 상체(척추)가 조준 방향으로 비틀린다 — 탑다운 게임의 핵심 트릭
func _update_procedural_motion(delta: float, planar: float) -> void:
	if model == null:
		return

	var accel_vec := (velocity - prev_velocity) / maxf(delta, 0.0001)
	prev_velocity = velocity

	# 진행 방향 기준 전후/좌우 가속 성분
	var fwd := Vector3(sin(model_yaw), 0, cos(model_yaw))
	var right := Vector3(fwd.z, 0, -fwd.x)
	var a_fwd: float = clampf(accel_vec.dot(fwd) * 0.006, -0.22, 0.22)
	var a_side: float = clampf(accel_vec.dot(right) * 0.005, -0.20, 0.20)

	lean_pitch = lerpf(lean_pitch, a_fwd, clampf(delta * 9.0, 0.0, 1.0))
	lean_roll = lerpf(lean_roll, -a_side, clampf(delta * 9.0, 0.0, 1.0))

	# 착지 스쿼시
	var on_floor := is_on_floor()
	if on_floor and not was_on_floor:
		land_squash = 0.25
	was_on_floor = on_floor
	if land_squash > 0.0:
		land_squash = maxf(0.0, land_squash - delta * 2.2)

	model.rotation.x = lean_pitch
	model.rotation.z = lean_roll
	# 원본 스케일에 곱한다 (덮어쓰면 92.5배 스케일이 사라져 캐릭터가 안 보인다)
	var squash := Vector3(1.0 + land_squash * 0.25, 1.0 - land_squash * 0.5, 1.0 + land_squash * 0.25)
	model.scale = base_scale * squash

	# 상체를 조준 방향으로 비틀기 — 애니메이션이 만든 현재 포즈 위에 얹는다
	if skel and spine_bones.size() > 0:
		var twist: float = wrapf(facing_angle - model_yaw, -PI, PI)
		twist = clampf(twist, -0.9, 0.9)
		var per_bone: float = twist / float(spine_bones.size())
		for bi in spine_bones:
			var cur := skel.get_bone_pose_rotation(bi)
			skel.set_bone_pose_rotation(bi, cur * Quaternion(Vector3.UP, per_bone))

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_SPACE:
		jump_buffer = 0.16

func _aim_at_mouse() -> void:
	var vp := get_viewport()
	if vp == null or camera == null:
		return
	var mouse := vp.get_mouse_position()
	var from := camera.project_ray_origin(mouse)
	var dir := camera.project_ray_normal(mouse)
	if absf(dir.y) < 0.0001:
		return
	var t := (global_position.y - from.y) / dir.y
	if t <= 0:
		return
	var target := from + dir * t
	var to_target := target - global_position
	to_target.y = 0
	if to_target.length() < 0.1:
		return
	facing_angle = atan2(to_target.x, to_target.z)

func facing_dir() -> Vector3:
	return Vector3(sin(facing_angle), 0, cos(facing_angle))

func shake(mag: float, dur: float) -> void:
	shake_mag = max(shake_mag, mag)
	shake_time = max(shake_time, dur)

func take_damage(amount: float) -> void:
	if invuln_timer > 0 or hp <= 0:
		return
	if parry_timer > 0:
		_parry_success()
		return
	hp -= amount
	hp_changed.emit()
	invuln_timer = 0.35
	shake(0.14, 0.15)
	SoundManager.play("player_hurt")
	_flash()
	if hp > 0 and anim and anim.has_animation("hit"):
		hit_anim_timer = 0.32
		anim.speed_scale = 1.6
		anim.play("hit")
	if hp <= 0:
		hp = 0
		_play_anim("die")
		died.emit()

func _flash() -> void:
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(1.0, 0.35, 0.35)
	m.emission_enabled = true
	m.emission = Color(1.0, 0.2, 0.2)
	m.emission_energy_multiplier = 1.5
	for mi in mesh_instances:
		if is_instance_valid(mi):
			mi.material_override = m
	var tw := create_tween()
	tw.tween_interval(0.12)
	tw.tween_callback(func():
		for mi in mesh_instances:
			if is_instance_valid(mi):
				mi.material_override = null
	)

func _start_dash() -> void:
	var dir := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP): dir.z -= 1
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN): dir.z += 1
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT): dir.x -= 1
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT): dir.x += 1
	if dir.length() == 0:
		dir = facing_dir()
	dash_dir = dir.normalized()
	dash_timer = DASH_DURATION
	dash_cd = DASH_COOLDOWN
	invuln_timer = max(invuln_timer, 0.22)
	SoundManager.play("dash")
	_spawn_dash_trail()

func _spawn_dash_trail() -> void:
	for i in range(4):
		var ghost := MeshInstance3D.new()
		var cyl := CylinderMesh.new()
		cyl.top_radius = 0.35
		cyl.bottom_radius = 0.35
		cyl.height = 1.6
		ghost.mesh = cyl
		var m := StandardMaterial3D.new()
		m.albedo_color = Color(0.5, 0.8, 1.0, 0.35)
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.emission_enabled = true
		m.emission = Color(0.4, 0.7, 1.0)
		m.emission_energy_multiplier = 1.5
		ghost.material_override = m
		ghost.position = global_position - dash_dir * (i * 0.7) + Vector3(0, 0.8, 0)
		get_parent().add_child(ghost)
		var tw := create_tween()
		tw.tween_property(m, "albedo_color:a", 0.0, 0.25)
		tw.parallel().tween_property(ghost, "scale", Vector3(0.4, 1.0, 0.4), 0.25)
		tw.tween_callback(ghost.queue_free)

func _slash() -> void:
	# 3타 콤보 — 연속으로 이으면 피해와 범위가 커진다
	if combo_timer > 0.0:
		combo_step = (combo_step + 1) % 3
	else:
		combo_step = 0
	combo_timer = COMBO_WINDOW

	var combo_mult: float = [1.0, 1.25, 1.9][combo_step]
	var range_mult: float = [1.0, 1.05, 1.35][combo_step]

	atk_cd = ATTACK_COOLDOWN
	attack_anim_timer = 0.30
	# 공격 중에는 마우스 방향으로 몸을 즉시 고정
	model_yaw = facing_angle
	if model:
		model.rotation.y = model_yaw
	if anim and anim.has_animation("attack-melee-right"):
		anim.speed_scale = 1.9   # Mixamo 검격은 느리므로 빠르게 재생
		anim.play("attack-melee-right")
	# 베는 순간 살짝 앞으로 파고든다
	velocity += facing_dir() * 3.5
	_spawn_slash_vfx(range_mult, combo_step)
	var kills := 0
	var hits := 0
	var fwd := facing_dir()
	var reach := ATTACK_RANGE * range_mult
	for enemy in get_tree().get_nodes_in_group("enemies"):
		if not is_instance_valid(enemy): continue
		var to_enemy: Vector3 = enemy.global_position - global_position
		to_enemy.y = 0
		if to_enemy.length() > reach + enemy.hit_radius: continue
		if fwd.angle_to(to_enemy.normalized()) > ATTACK_HALF_ANGLE: continue
		hits += 1
		if enemy.take_damage(slash_damage * combo_mult, to_enemy.normalized() * 4.0 * combo_mult):
			kills += 1
	if hits > 0:
		SoundManager.play("hit", 0.0, 0.12)
	if hits > 0 and combo_step == 2:
		GameManager.hitstop(0.1)
		shake(0.26, 0.2)
	if kills > 0:
		ult_gauge = min(ult_max, ult_gauge + kills * 4)
		ult_changed.emit()
		GameManager.hitstop(min(0.14, 0.03 + kills * 0.02))
		shake(min(0.22, 0.06 + kills * 0.04), 0.15)

func _make_arc_mesh(radius: float, half_angle: float, inner: float) -> ArrayMesh:
	var verts := PackedVector3Array()
	var steps := 16
	for i in range(steps):
		var a0 := -half_angle + (half_angle * 2.0) * (float(i) / steps)
		var a1 := -half_angle + (half_angle * 2.0) * (float(i + 1) / steps)
		var o0 := Vector3(sin(a0), 0, cos(a0)) * radius
		var o1 := Vector3(sin(a1), 0, cos(a1)) * radius
		var i0 := Vector3(sin(a0), 0, cos(a0)) * inner
		var i1 := Vector3(sin(a1), 0, cos(a1)) * inner
		# 양면으로 두 삼각형씩
		verts.append_array([i0, o0, o1])
		verts.append_array([i0, o1, i1])
		verts.append_array([o1, o0, i0])
		verts.append_array([i1, o1, i0])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = verts
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	return am

## 검기 — 칼이 지나간 부채꼴 궤적이 순간적으로 번쩍인다
func _spawn_slash_vfx(range_mult: float = 1.0, step: int = 0) -> void:
	var r := ATTACK_RANGE * range_mult
	var mesh := MeshInstance3D.new()
	mesh.mesh = _make_arc_mesh(r, ATTACK_HALF_ANGLE, r * 0.35)
	var m := StandardMaterial3D.new()
	# 3타째는 흰빛에 가깝게 강조
	m.albedo_color = Color(1.0, 0.35, 0.28, 0.85) if step < 2 else Color(1.0, 0.78, 0.5, 0.95)
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.emission_enabled = true
	m.emission = Color(1.0, 0.22, 0.15)
	m.emission_energy_multiplier = 6.0
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	mesh.material_override = m
	get_parent().add_child(mesh)
	mesh.global_position = global_position + Vector3(0, 1.0, 0)
	mesh.rotation.y = facing_angle

	# 베는 방향으로 궤적이 훑고 지나가는 느낌
	mesh.scale = Vector3(0.5, 1.0, 0.5)
	var tw := create_tween()
	tw.tween_property(mesh, "scale", Vector3(1.15, 1.0, 1.15), 0.09).set_trans(Tween.TRANS_SINE)
	tw.parallel().tween_property(mesh, "rotation:y", facing_angle + 0.35, 0.09)
	tw.tween_property(m, "albedo_color:a", 0.0, 0.14)
	tw.parallel().tween_property(m, "emission_energy_multiplier", 0.0, 0.14)
	tw.tween_callback(mesh.queue_free)

	# 칼끝 섬광
	var spark := OmniLight3D.new()
	spark.light_color = Color(1.0, 0.4, 0.3)
	spark.light_energy = 3.5
	spark.omni_range = 6.0
	spark.position = global_position + facing_dir() * (r * 0.5) + Vector3(0, 1.2, 0)
	get_parent().add_child(spark)
	var tw2 := create_tween()
	tw2.tween_property(spark, "light_energy", 0.0, 0.16)
	tw2.tween_callback(spark.queue_free)

func _ultimate() -> void:
	ult_gauge = 0
	ult_changed.emit()
	SoundManager.play("ultimate")
	GameManager.hitstop(0.22, 0.04)
	shake(0.4, 0.45)
	for enemy in get_tree().get_nodes_in_group("enemies"):
		if not is_instance_valid(enemy): continue
		var flat: Vector3 = enemy.global_position - global_position
		flat.y = 0
		if flat.length() <= ULT_RADIUS:
			enemy.take_damage(999, flat.normalized() * 3.0)
	_spawn_ult_vfx()

func _spawn_ult_vfx() -> void:
	var mesh := MeshInstance3D.new()
	var sphere := SphereMesh.new()
	sphere.radius = ULT_RADIUS
	sphere.height = ULT_RADIUS * 2.0
	mesh.mesh = sphere
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(0.6, 0.85, 1.0, 0.4)
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.emission_enabled = true
	m.emission = Color(0.5, 0.8, 1.0)
	m.emission_energy_multiplier = 4.0
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	mesh.material_override = m
	mesh.position = global_position + Vector3(0, 1.0, 0)
	mesh.scale = Vector3(0.15, 0.15, 0.15)
	get_parent().add_child(mesh)

	var flash := OmniLight3D.new()
	flash.position = global_position + Vector3(0, 1.5, 0)
	flash.light_color = Color(0.6, 0.85, 1.0)
	flash.light_energy = 8.0
	flash.omni_range = ULT_RADIUS * 2.0
	get_parent().add_child(flash)

	var tw := create_tween()
	tw.tween_property(mesh, "scale", Vector3(1.1, 0.5, 1.1), 0.45)
	tw.parallel().tween_property(m, "albedo_color:a", 0.0, 0.45)
	tw.parallel().tween_property(flash, "light_energy", 0.0, 0.45)
	tw.tween_callback(mesh.queue_free)
	tw.tween_callback(flash.queue_free)

func _ranged_wave() -> void:
	ranged_cd = RANGED_COOLDOWN
	attack_anim_timer = 0.34
	model_yaw = facing_angle
	if model:
		model.rotation.y = model_yaw
	if anim and anim.has_animation("attack-melee-left"):
		anim.speed_scale = 1.6
		anim.play("attack-melee-left")
	var half_width := 1.4
	var dir := facing_dir()
	var kills := 0
	var hits := 0
	for enemy in get_tree().get_nodes_in_group("enemies"):
		if not is_instance_valid(enemy): continue
		var rel: Vector3 = enemy.global_position - global_position
		rel.y = 0
		var proj := rel.dot(dir)
		if proj < 0 or proj > RANGED_RANGE: continue
		var perp := (rel - dir * proj).length()
		if perp > half_width + enemy.hit_radius: continue
		hits += 1
		if enemy.take_damage(slash_damage * 2.0, dir * 3.0):
			kills += 1
	if hits > 0:
		SoundManager.play("hit", 0.0, 0.12)
	if kills > 0:
		ult_gauge = min(ult_max, ult_gauge + kills * 4)
		ult_changed.emit()
	_spawn_beam_vfx(dir)

func _spawn_beam_vfx(dir: Vector3) -> void:
	var mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(2.4, 1.2, RANGED_RANGE)
	mesh.mesh = box
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(0.5, 0.9, 1.0, 0.55)
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.emission_enabled = true
	m.emission = Color(0.45, 0.85, 1.0)
	m.emission_energy_multiplier = 4.0
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mesh.material_override = m
	mesh.position = global_position + dir * (RANGED_RANGE * 0.5) + Vector3(0, 1.0, 0)
	mesh.rotation.y = facing_angle
	get_parent().add_child(mesh)
	var tw := create_tween()
	tw.tween_property(m, "albedo_color:a", 0.0, 0.25)
	tw.tween_callback(mesh.queue_free)

func _start_parry() -> void:
	parry_cd = PARRY_COOLDOWN
	parry_timer = PARRY_WINDOW
	_spawn_parry_vfx()

func _parry_success() -> void:
	parry_timer = 0
	SoundManager.play("hit", 0.0, 0.1)
	GameManager.hitstop(0.12, 0.05)
	shake(0.2, 0.2)
	for enemy in get_tree().get_nodes_in_group("enemies"):
		if not is_instance_valid(enemy): continue
		var flat: Vector3 = enemy.global_position - global_position
		flat.y = 0
		if flat.length() <= 6.0:
			enemy.stun(1.2)
			enemy.take_damage(slash_damage, flat.normalized() * 7.0)

func _spawn_parry_vfx() -> void:
	var mesh := MeshInstance3D.new()
	var torus := TorusMesh.new()
	torus.inner_radius = 0.9
	torus.outer_radius = 1.3
	mesh.mesh = torus
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(1.0, 0.9, 0.4, 0.6)
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.emission_enabled = true
	m.emission = Color(1.0, 0.85, 0.3)
	m.emission_energy_multiplier = 3.0
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mesh.material_override = m
	mesh.position = Vector3(0, 1.0, 0)
	add_child(mesh)
	var tw := create_tween()
	tw.tween_property(m, "albedo_color:a", 0.0, PARRY_WINDOW + 0.15)
	tw.tween_callback(mesh.queue_free)
